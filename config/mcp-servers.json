{
  "$comment": "Source of truth for RUSHYOP MCP servers. Runtime fields (type/command/args/url/headers/env) are what clients consume. `_rushy` is marketplace-only metadata and MUST be stripped before writing to Claude/Grok/Cursor/Gemini. Secrets stay ${ENV_VAR} placeholders — never bake tokens in. Plugins are generated by scripts/generate-mcp-plugins.sh (defaultEnabled=false). Apply with ./scripts/apply-mcp.sh (off by default).",
  "version": "2.0.0",
  "mcpServers": {
    "whispr-flow": {
      "type": "http",
      "url": "https://api.wisprflow.ai/connect/mcp",
      "_rushy": {
        "description": "Wispr Flow voice-to-text MCP (HTTP). OAuth on first connect.",
        "defaultEnabled": false,
        "env": [],
        "notes": "Claude listed this as 'whispr flow' (space). Plugin/server name is hyphenated so Grok/Cursor accept it."
      }
    },
    "obsidian": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@mauricio.wolff/mcp-obsidian@latest", "${OBSIDIAN_VAULT_PATH}"],
      "env": {},
      "_rushy": {
        "description": "Read/search a local Obsidian vault.",
        "defaultEnabled": false,
        "env": ["OBSIDIAN_VAULT_PATH"],
        "notes": "Set OBSIDIAN_VAULT_PATH to the absolute vault directory."
      }
    },
    "atlassian-confluence": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://mcp.atlassian.com/v1/mcp/authv2",
        "--header",
        "X-Atlassian-Site:${ATLASSIAN_SITE}"
      ],
      "_rushy": {
        "description": "Atlassian Confluence / Jira via official remote MCP.",
        "defaultEnabled": false,
        "env": ["ATLASSIAN_SITE"],
        "notes": "ATLASSIAN_SITE is the site origin, e.g. https://yourorg.atlassian.net. OAuth is interactive on first use."
      }
    },
    "pdf-reader": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@sylphx/pdf-reader-mcp"],
      "env": {},
      "_rushy": {
        "description": "PDF read / search / OCR.",
        "defaultEnabled": false,
        "env": [],
        "notes": ""
      }
    },
    "nebulastudio-mcp": {
      "type": "http",
      "url": "https://designeridst.ramcouat.com/coregwops/proxy/coremcp/mcp",
      "_rushy": {
        "description": "Ramco Nebula Studio (UAT) MCP.",
        "defaultEnabled": false,
        "env": [],
        "notes": "Requires Ramco network access."
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {},
      "_rushy": {
        "description": "Playwright browser automation MCP.",
        "defaultEnabled": false,
        "skipPlugin": true,
        "env": ["PLAYWRIGHT_USER_DATA_DIR"],
        "notes": "No first-party plugin: playwright@rushy already ships this MCP. Optional PLAYWRIGHT_USER_DATA_DIR for a persistent Chrome profile. Do not run this AND the plugin together."
      }
    },
    "mcp-uds-server": {
      "type": "http",
      "url": "http://hcmwascnv70.pearl.com/UDSMCPServer/mcp",
      "_rushy": {
        "description": "Ramco UDS GraphQL MCP.",
        "defaultEnabled": false,
        "env": [],
        "notes": "Internal pearl.com network."
      }
    },
    "rapids-mcp": {
      "type": "http",
      "url": "http://hcmwascnv70.pearl.com/RapidsMCPServer/mcp",
      "headers": {
        "Authorization": "Bearer ${RAPIDS_MCP_TOKEN}",
        "context-ou-id": "27",
        "context-role-name": "MCP_Role",
        "context-lang-id": "1"
      },
      "_rushy": {
        "description": "Ramco RAPIDS MCP.",
        "defaultEnabled": false,
        "env": ["RAPIDS_MCP_TOKEN"],
        "notes": "Internal pearl.com network. Token from RAPIDS_MCP_TOKEN — never commit the real value."
      }
    },
    "excalidraw": {
      "type": "http",
      "url": "https://api.excalidraw.com/api/v1/mcp",
      "headers": {
        "Authorization": "Bearer ${EXCALIDRAW_MCP_TOKEN}"
      },
      "_rushy": {
        "description": "Excalidraw hosted MCP (diagrams).",
        "defaultEnabled": false,
        "env": ["EXCALIDRAW_MCP_TOKEN"],
        "notes": "Distinct from first-party plugin excalidraw-pages (HTML pages). Token via EXCALIDRAW_MCP_TOKEN."
      }
    },
    "miro-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-remote@latest", "https://mcp.miro.com/"],
      "env": {},
      "_rushy": {
        "description": "Miro boards via official remote MCP.",
        "defaultEnabled": false,
        "env": [],
        "notes": "OAuth on first connect. Discovered from a Claude project config."
      }
    },
    "shadcn": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"],
      "_rushy": {
        "description": "shadcn/ui registry MCP.",
        "defaultEnabled": false,
        "env": [],
        "notes": "From ~/.mcp.json. Complements agent-tooling's shadcn skill; this plugin is the MCP server only."
      }
    },
    "rxds-figma-mcp": {
      "type": "stdio",
      "command": "node",
      "args": ["${RXDS_FIGMA_MCP_ENTRY}"],
      "env": {
        "FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN}",
        "RXDS_COMPONENTS_PATH": "${RXDS_COMPONENTS_PATH}",
        "RXDS_FIGMA_MCP_CONFIG": "${RXDS_FIGMA_MCP_CONFIG}"
      },
      "_rushy": {
        "description": "Local RXDS Figma MCP (Ramco design-system components).",
        "defaultEnabled": false,
        "env": [
          "RXDS_FIGMA_MCP_ENTRY",
          "FIGMA_ACCESS_TOKEN",
          "RXDS_COMPONENTS_PATH",
          "RXDS_FIGMA_MCP_CONFIG"
        ],
        "notes": "Machine-local server. RXDS_FIGMA_MCP_ENTRY is the compiled entry (e.g. /path/to/rxds-figma-mcp/dist/mcp/index.js). Not useful to consumers without that checkout."
      }
    }
  }
}
