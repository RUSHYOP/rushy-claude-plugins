{
  "name": "atlassian-confluence",
  "version": "1.0.0",
  "mcpServers": {
    "atlassian-confluence": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://mcp.atlassian.com/v1/mcp/authv2",
        "--header",
        "X-Atlassian-Site:${ATLASSIAN_SITE}"
      ]
    }
  },
  "settings": [
    {
      "name": "ATLASSIAN_SITE",
      "description": "Required env for atlassian-confluence",
      "envVar": "ATLASSIAN_SITE",
      "sensitive": false
    }
  ]
}
