{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "miro-mcp",
  "version": "1.0.0",
  "description": "Miro boards via official remote MCP.",
  "author": {
    "name": "RUSHYOP",
    "email": "alwayspurav@gmail.com"
  },
  "defaultEnabled": false,
  "keywords": [
    "mcp",
    "opt-in"
  ],
  "mcpServers": {
    "miro-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://mcp.miro.com/"
      ],
      "env": {}
    }
  }
}
