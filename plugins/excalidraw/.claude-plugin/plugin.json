{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "excalidraw",
  "version": "1.0.0",
  "description": "Excalidraw hosted MCP (diagrams).",
  "author": {
    "name": "RUSHYOP",
    "email": "alwayspurav@gmail.com"
  },
  "defaultEnabled": false,
  "keywords": [
    "mcp",
    "opt-in"
  ],
  "mcpServers": {
    "excalidraw": {
      "type": "http",
      "url": "https://api.excalidraw.com/api/v1/mcp",
      "headers": {
        "Authorization": "Bearer ${EXCALIDRAW_MCP_TOKEN}"
      }
    }
  }
}
