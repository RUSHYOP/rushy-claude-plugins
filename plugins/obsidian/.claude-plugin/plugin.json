{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "obsidian",
  "version": "1.0.0",
  "description": "Read/search a local Obsidian vault.",
  "author": {
    "name": "RUSHYOP",
    "email": "alwayspurav@gmail.com"
  },
  "defaultEnabled": false,
  "keywords": [
    "mcp",
    "opt-in"
  ],
  "mcpServers": {
    "obsidian": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@mauricio.wolff/mcp-obsidian@latest",
        "${OBSIDIAN_VAULT_PATH}"
      ],
      "env": {}
    }
  }
}
